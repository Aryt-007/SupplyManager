<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:id="@+id/activity_notes_taker_btn_add"
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="250dp"
    android:layout_height="100dp"
    android:orientation="vertical"
    android:background="@color/white">
    <EditText
        android:id="@+id/number_add"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:inputType="number"
        android:gravity="center"
        android:padding="8dp"

        android:textSize="20sp"
        android:textColor="@color/black"
        />
    <RelativeLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/imageView_cancellation_taker"

            android:layout_width="?attr/actionBarSize"
            android:layout_height="?attr/actionBarSize"

            android:src="@drawable/cancellation_black"
            android:padding="6dp"
            android:background="@android:color/transparent"
            />

        <ImageView
            android:id="@+id/imageView_save_taker"

            android:layout_width="?attr/actionBarSize"
            android:layout_height="?attr/actionBarSize"

            android:src="@drawable/save_black"
            android:padding="6dp"
            android:background="@android:color/transparent"

            android:layout_alignParentEnd="true"
            />
    </RelativeLayout>

</LinearLayout>