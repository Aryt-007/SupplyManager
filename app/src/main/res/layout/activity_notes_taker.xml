<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/activity_notes_taker"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    android:orientation="vertical"
    tools:context=".NotesTakerActivity">

    <!-- Топбар с кнопками "Отмена" и "Сохранить" -->
    <Toolbar
        android:id="@+id/toolBar_notes"
        android:title="@string/app_name"
        android:titleTextColor="@color/white"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageView
                android:id="@+id/imageView_save"
                android:layout_alignParentEnd="true"
                android:src="@drawable/save"
                android:padding="6dp"
                android:background="@android:color/transparent"
                android:layout_width="?attr/actionBarSize"
                android:layout_height="?attr/actionBarSize"/>

            <ImageView
                android:id="@+id/imageView_cancellation"
                android:src="@drawable/cancellation"
                android:padding="6dp"
                android:background="@android:color/transparent"
                android:layout_width="?attr/actionBarSize"
                android:layout_height="?attr/actionBarSize"/>
        </RelativeLayout>
    </Toolbar>

    <!-- Заголовок -->
    <EditText
        android:id="@+id/editText_tittle"
        android:inputType="textCapSentences"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Тема: "
        android:textColorHint="@color/white"
        android:padding="10dp"
        android:textStyle="bold"
        android:textSize="20sp"
        android:textColor="@color/white"
        android:singleLine="true"
        />

    <!-- Текст -->
    <EditText
        android:id="@+id/editText_notes"
        android:inputType="textCapSentences"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Текст: "
        android:textColorHint="@color/white"
        android:padding="8dp"
        android:textStyle="normal"
        android:textSize="18sp"
        android:textColor="@color/white"
        />

    <!-- ЗАМЕНА TableLayout на FrameLayout -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <TableLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            >
            <TableRow>
                <TextView
                    android:id="@+id/name_food"
                    android:layout_width="250dp"
                    android:layout_height="wrap_content"
                    android:textSize="20sp"

                    android:background="@color/black"
                    android:textColor="@color/white"

                    android:gravity="center_horizontal"
                    android:textStyle="bold"

                    android:text="Название" />

                <TextView
                    android:id="@+id/count_food"
                    android:layout_width="120dp"
                    android:layout_height="wrap_content"
                    android:textSize="20sp"

                    android:background="@color/black"
                    android:textColor="@color/white"

                    android:gravity="center_horizontal"
                    android:textStyle="bold"

                    android:text="Количетсво"
                    />

                <TextView
                    android:id="@+id/btn_up_down"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="20sp"

                    android:background="@color/black"
                    android:textColor="@color/white"

                    android:gravity="center_horizontal"
                    android:textStyle="bold"

                    />
            </TableRow>
            <TableRow>
                <EditText
                    android:id="@+id/text_tittle"
                    android:inputType="textCapSentences"

                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:textColorHint="@color/white"
                    android:textStyle="normal"
                    android:textSize="18sp"

                    android:padding="8dp"

                    android:textColor="@color/white"
                />
                <EditText
                    android:id="@+id/count_tittle"
                    android:inputType="number"

                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:textColorHint="@color/white"
                    android:textStyle="normal"
                    android:textSize="18sp"

                    android:padding="8dp"

                    android:textColor="@color/white"
                />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    >
                    <ImageButton
                        android:id="@+id/btn_up"

                        android:layout_width="40dp"
                        android:layout_height="20dp"

                        android:src="@drawable/btn_up"
                        android:scaleType="centerInside"
                        android:background="@drawable/bg_circle_black"
                        />
                    <ImageButton
                        android:id="@+id/btn_down"

                        android:layout_width="40dp"
                        android:layout_height="20dp"

                        android:src="@drawable/btn_down"
                        android:scaleType="centerInside"
                        android:background="@drawable/bg_circle_black"
                        />
                </LinearLayout>

            </TableRow>
        </TableLayout>

        <ImageButton
            android:id="@+id/btn_add"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:layout_marginHorizontal="300dp"
            android:layout_marginVertical="450dp"

            android:src="@drawable/btn_add"
            android:background="@drawable/bg_circle_black"
            android:scaleType="centerInside"
            />
    </RelativeLayout>

</LinearLayout>